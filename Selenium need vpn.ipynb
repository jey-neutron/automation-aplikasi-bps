    "        except:\n",
    "            a=''\n",
    "            pass\n",
    "        #print(a)\n",
    "        hasilquery = driver.find_element_by_css_selector('div.table-fixed').text#.text[:200]\n",
    "        # adakah isi query\n",
    "        if \"KD_SAMPEL\" in a or \",*\" in a.upper().replace(\" \", \"\") or a.upper().replace(\" \",\"\")=='*' or hasilquery == '' or '4.23' in iquery.text.lower() or '4.24' in iquery.text.lower():\n",
    "            pass\n",
    "        else:\n",
    "            #print()\n",
