    "            pass\n",
    "        \n",
    "        # get isi execute\n",
    "        hasilquery = driver.find_element_by_css_selector('div.table-fixed').text#.text[:200]\n",
    "        # adakah isi query\n",
    "        if hasilquery == '':\n",
    "            print(\"Kosong\", end = \" \")\n",
    "        elif \"Error\" in hasilquery:\n",
    "            hasilquery = \"SQL \"+hasilquery\n",
